SSLCOMMERZ_STORE_PASSWD="your_sslcz_store_password"
SSLCOMMERZ_IS_SANDBOX="true"

# 4. Stripe Global Gateway (Future activation)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
